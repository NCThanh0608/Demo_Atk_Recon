[Unit]
Description=Red Team Ops Console (web console + control API, Raspberry Pi AP mode)
Documentation=file:/home/pi/demo_atk_recon/WEB.MD
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/demo_atk_recon
# Backend serves the static frontend AND the /api control endpoints on one port
# (same-origin, reachable via the Pi AP, e.g. http://10.42.0.1:8080).
ExecStart=/usr/bin/python3 /home/pi/demo_atk_recon/backend/server.py
Environment=RTOPS_PORT=8080
Restart=on-failure
RestartSec=3
# Grant raw-socket capability so nmap (run as the unprivileged pi user) can do
# ARP host discovery -> MAC address + vendor, and SYN scans. Ambient caps are
# inherited by the nmap child; this is the NoNewPrivileges-safe way to do it
# (a plain `setcap` on the nmap binary would be ignored under NoNewPrivileges).
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
# Hardening. PrivateTmp gives the scanner its own /tmp for nmap XML output.
# /home stays writable so the audit log (logs/session.ndjson) can be written.
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ReadWritePaths=/home/pi/demo_atk_recon/logs

[Install]
WantedBy=multi-user.target
